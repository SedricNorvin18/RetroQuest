rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Match the path for profile pictures
    match /profile_pictures/{userId}/{allPaths=**} {
      // Allow a user to write (upload, update, delete) to their own folder
      allow write: if request.auth != null && request.auth.uid == userId;
      // Allow anyone to read profile pictures
      allow read;
    }

    // NEW RULE: Match the path for question images
    match /question_images/{allPaths=**} {
      // Allow creation/upload and reading if the user is authenticated
      allow read, write: if request.auth != null;
    }
  }
}